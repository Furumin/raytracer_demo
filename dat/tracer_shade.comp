#version 460
#include "core.glsl"
#include "tracer_core.glsl"
layout(std430, push_constant) uniform Push_T {
  Rs_pcd Data;
} Push;
layout(local_size_x = TRACER_RS_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
void main() {
  Rs_pcd data = Push.Data;
  uint rayIdx = uint(gl_GlobalInvocationID.x);
  if (rayIdx >= data.RayCount) return;
  ivec2 imagePos = imagePixelPosFromRayIdx(rayIdx, data.Dimensions, data.RaysPerPixelPow2);
  RayChunkBuffer rayBuffer = RayChunkBuffer(data.RayBuffer);
  HitChunkBuffer hitBuffer = HitChunkBuffer(data.HitBuffer);
  MaterialChunkBuffer materialBuffer = MaterialChunkBuffer(data.MaterialBuffer);
  
  vec4 clr = vec4(0.0, 0.0, 0.0, 1.0); // bg
  Hit_record hit = loadHitByIdx(hitBuffer, rayIdx);
  Ray ray = loadRayByIdx(rayBuffer, rayIdx);
  if (hit.Data != 0xffffffff) {
    if (data.Depth != 0) clr = vec4(1.0);
    Material m = loadMaterialByIdx(materialBuffer, hit.Data);
    clr.xyz = m.Color;
    vec2 n = hit.Normal;
    uint signBit = floatBitsToUint(n.y) & 1;
    float dirZ = sqrt(1.0 - dot(hit.Normal, hit.Normal));
    dirZ *= (signBit == 1 ? 1.0 : -1.0);
    vec3 norm = vec3(hit.Normal, dirZ);
    const vec3 oldDir = ray.Direction;
    bool frontFace = dot(norm, oldDir) < 0.0; // positive if front facing
    uint hash = data.Hash + hash1(rayIdx);
    
    // scatter ray based on material
    ray.Direction = normalize(norm + randomHemisphereVec3(hash, norm) * m.Roughness);
    // refraction
    if (m.RefractionIndex > 0.0) {
      float ri = frontFace? 1.0 / m.RefractionIndex : m.RefractionIndex;
      norm = frontFace ? norm : -norm;
      vec3 unitDir = normalize(oldDir);
      float cosT = min(dot(-unitDir, norm), 1.0);
      float sinT = sqrt(1.0 - cosT * cosT);

      bool cannotRefl = ri * sinT > 1.0;
      float reflectance;
      float r0 = (1.0 - m.RefractionIndex) / (1.0 + m.RefractionIndex);
      r0 *= r0;
      reflectance = r0 + (1.0 - r0) * pow(1.0 - cosT, 5.0);
      ray.Direction = cannotRefl || reflectance > abs(randomFloatNorm(hash)) ? reflect(unitDir, norm) : refract(unitDir, norm, ri);
    } else if ((m.Flags & TRACER_MATERIAL_FLAG_METALLIC) != 0) {
      ray.Direction = reflect(oldDir, norm);
    }

    ray.Position = hit.HitPosition + ray.Direction * 0.003; // avoid self-shadowing
  } else {
    clr.rgb = vec3(0.97, 1.0, 1.0);
  }
  ray.Color *= clr;
  storeRayByIdx(rayBuffer, rayIdx, ray);
}
