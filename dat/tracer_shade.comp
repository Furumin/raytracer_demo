#version 460
#include "core.glsl"
#include "tracer_core.glsl"
layout(std430, push_constant) uniform Push_T {
  Rs_pcd Data;
} Push;
layout(local_size_x = TRACER_RS_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
void kernel(in uint rayIdx, in uint localRayIdx) {
  Rs_pcd data = Push.Data;
  if (localRayIdx >= data.RayCount) return;
  RayChunkBuffer rayBuffer = RayChunkBuffer(data.RayBuffer);
#if TRACER_RAY_HIT_UNIFIED
  Hit_record hit = loadHitByIdx(rayBuffer, localRayIdx);
#else
  HitChunkBuffer hitBuffer = HitChunkBuffer(data.HitBuffer);
  Hit_record hit = loadHitByIdx(hitBuffer, localRayIdx);
#endif
  MaterialChunkBuffer materialBuffer = MaterialChunkBuffer(data.MaterialBuffer);
  
  vec3 clr = data.SkyColor.xyz;
  Ray ray = loadRayByIdx(rayBuffer, localRayIdx, true, false);
  // skip rays that stopped at previous frames
  int rayDepth = int(ray.Data >> TRACER_DEPTH_O);
  int passDepth = int(data.DepthAndFlags >> 16);
  if (abs(passDepth - rayDepth) > 1) return;
  uint materialIndex = (ray.Data & TRACER_MATERIAL_INDEX_MASK) >> 2;
  const bool regularization = false && (ray.Data & TRACER_RAY_HIT_DIFFUSE_FLAG) != 0;
  if (materialIndex != TRACER_INVALID_MATERIAL) {
    Material m = loadMaterialByIdx(materialBuffer, materialIndex);
    clr = m.Color;
    uint signBit = floatBitsToUint(hit.Normal.y) & 1;
    // use absolute value in case len(hit.Normal) > 1 (due to fp precision error)
    float dirZ = sqrt(abs(1.0 - dot(hit.Normal, hit.Normal)));
    dirZ *= (signBit == 1 ? 1.0 : -1.0);
    vec3 norm = vec3(hit.Normal, dirZ);
    bool frontFace = dot(norm, ray.Direction) < 0.0; // positive if front facing
    // hashes 
    uvec3 hash = data.Hash.xwz + hash1(rayIdx);
    
    // scatter ray based on material
    // refraction
    if (m.RefractionIndex > 0.0) {
      float ri = frontFace? 1.0 / m.RefractionIndex : m.RefractionIndex;
      norm = frontFace ? norm : -norm;
      vec3 unitDir = normalize(ray.Direction);
      float cosT = min(dot(-unitDir, norm), 1.0);
      float sinT = sqrt(max(0.0, 1.0 - cosT * cosT));

      bool cannotRefl = ri * sinT > 1.0;
      float reflectance;
      float r0 = (1.0 - m.RefractionIndex) / (1.0 + m.RefractionIndex);
      r0 *= r0;
      reflectance = r0 + (1.0 - r0) * pow(1.0 - cosT, 5.0);
      ray.Direction = cannotRefl || reflectance > abs(randomFloatNorm(hash.x)) ? reflect(unitDir, norm) : refract(unitDir, norm, ri);
      // ray path regularization
      if (regularization) {
	ray.Direction = normalize(randomConeDir(hash.zx, ray.Direction, 0.92));
      }
    } else if ((m.Flags & TRACER_MATERIAL_FLAG_METALLIC) != 0) {
      ray.Direction = reflect(ray.Direction, norm);
      // ray path regularization
      const float effRoughness = (regularization ? max(0.1, m.Roughness) : m.Roughness); 
      ray.Direction = normalize(ray.Direction + randomUnitVec3(hash.xzy) * effRoughness);
    } else {
      // non-specular
      ray.Data |= TRACER_RAY_HIT_DIFFUSE_FLAG;
      // (todo) GGX model using roughness parameter in material
      // (todo) support for more than one light source

      // generate random dir. on hemisphere (assuming lambertian material
      const vec3 matDir = randomCosDir(hash.yz, norm);
      vec3 v = matDir;
      
      // if no pdf is disabled => if pdf is enabled
      if ((data.DepthAndFlags & TRACER_RS_NO_PDF_BIT) == 0) {
	const vec3 lightPos = data.SunData.xyz;
	vec3 lightDir = lightPos - hit.HitPosition;
	const float lightRad = data.SunData.w;
	const float distSq = dot(lightDir, lightDir);
	lightDir = normalize(lightDir);

	const float cosThMax = sqrt(max(1.0 - lightRad * lightRad / distSq, 0.0));
	// (todo) more sophisticated next event estimation via shadow rays?
	const float rand = randomFloatNorm(hash1(hash.x) + rayIdx) * 0.5 + 0.5;
	float sunWeight = 0.5 * max(0.0, dot(norm, lightDir));
	vec3 sunDir = randomConeDir(hash.zx, lightDir, cosThMax);
	v = rand >= sunWeight ? matDir : sunDir;
	// PI not included as they cancel out 
	const float lightPdf = dot(lightDir, v) >= cosThMax ? (1.0 / (2.0 * (1.0 - cosThMax))) : 0;
	const float matPdf = max(dot(norm, v), 0.0);
	const float mixPdf = (1.0 - sunWeight) * matPdf + (sunWeight) * lightPdf;
	// dot norm v is the cos th in the rendering eq. 
	clr *= max(dot(norm, v), 0.0) / mixPdf;
      }
      ray.Direction = v;
    }
    if ((m.Flags & TRACER_MATERIAL_FLAG_EMISSIVE) != 0) {
      ray.Data &= ~(TRACER_MAX_DEPTH << TRACER_DEPTH_O); // stop tracing ray, by setting depth to 0
      ray.Data |= TRACER_RAY_HIT_EMISSIVE_BIT; // set bit, indicating that the ray hit a light
    }
    ray.Position = hit.HitPosition + ray.Direction * 0.003; // avoid self-shadowing
  }
  ray.Color.xyz *= clr;
  
  // if on the last bounce, remove all color IF the ray never hit any light
  if ((data.DepthAndFlags & TRACER_RS_LAST_BOUNCE_BIT) > 0)
    ray.Color.xyz *= float(ray.Data & TRACER_RAY_HIT_EMISSIVE_BIT);
  
  ray.Color.xyz = clamp(ray.Color.xyz, vec3(0.0), vec3(10000.0));
  storeRayByIdx(rayBuffer, localRayIdx, ray, true, true);
}

void main() {
#if TRACER_PERSISTENT_THREADS
  if (gl_GlobalInvocationID.x == 0) {
    GlobalCountBuffer gcb = GlobalCountBuffer(Push.Data.GlobalCountBuffer);
    gcb.Count = 0;
  }
#endif
  const uint stride = (Push.Data.RayCount + TRACER_RS_COARSE_FACTOR - 1) / TRACER_RS_COARSE_FACTOR;
  for (uint i = 0; i < TRACER_RS_COARSE_FACTOR; i++) {
    uint localRayIdx = uint(gl_GlobalInvocationID.x) + i * stride;
    uint rayIdx = Push.Data.RayIdxOffset + localRayIdx;
    kernel(rayIdx, localRayIdx);
  }
}
