#version 460
#include "core.glsl"
#include "tracer_core.glsl"
layout(std430, push_constant) uniform Push_T {
  Sw_pcd Data;
} Push;
layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;
#define _IMG (_images_rgba8[nonuniformEXT(Push.Data.ImageStorageHandle)])
#define _TIMG (_images_rgba8[nonuniformEXT(Push.Data.TonemapImageStorageHandle)])
// due to partial rasterization in the case of large ray counts,
// we use ray idx (which may be offsetted) to calc. image pos, rather then
// the opposite.
void main() {
  Sw_pcd data = Push.Data;
  uint raysPerPixel = 1 << data.RaysPerPixelPow2;
  uint localPixelIdx = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * data.Dimensions.x;
  uint pixelIdx = (Push.Data.RayIdxOffset >> Push.Data.RaysPerPixelPow2) + localPixelIdx;
  uint localRayIdx = localPixelIdx * raysPerPixel;
  uint rayIdx = Push.Data.RayIdxOffset + localRayIdx;
  if (localRayIdx >= Push.Data.RayCount) return;
  ivec2 imagePos = ivec2(pixelIdx % data.Dimensions.x, pixelIdx / data.Dimensions.x);
  RayChunkBuffer rayBuffer = RayChunkBuffer(data.RayBuffer);
  vec3 accum = vec3(0.0);

  // gather all samples
  float weightSum = 0.0;
  if (raysPerPixel > 1 && data.EnableCorrectReconstruction > 0) {
    for (int x = -2; x < 3; x++) {
      for (int y = -2; y < 3; y++) {
	ivec2 off = ivec2(x, y) + imagePos;
	if (any(lessThan(off, ivec2(0))) || any(greaterThanEqual(off, ivec2(data.Dimensions))))
	  continue;
	int thisLocalPixelIdx = int(localPixelIdx) + (x + y * int(data.Dimensions.x));
	pixelIdx = int(Push.Data.RayIdxOffset >> Push.Data.RaysPerPixelPow2) + localPixelIdx;
	if (pixelIdx < 0 || thisLocalPixelIdx >= (Push.Data.RayCount >> Push.Data.RaysPerPixelPow2)) continue;
	for (int i = 0; i < raysPerPixel; i++) {
	  localRayIdx = thisLocalPixelIdx * int(raysPerPixel) + i;
	  rayIdx = int(Push.Data.RayIdxOffset) + localRayIdx;
	  vec3 rayClr = loadRayClrByIdx(rayBuffer, localRayIdx);

	  vec2 samplePos = imagePosFromRayIdx(rayIdx, data.Dimensions, data.RaysPerPixelPow2, data.Hash.xy, data.EnableAntiAliasing, data.EnableStratifiedSampling);
	  samplePos -= (vec2(imagePos) + 0.5); // make into relative position
	  float w = mitchell2d(samplePos, 0.5, 1.0 / 3.0, 1.0 / 3.0);
	  accum += rayClr * w;
	  weightSum += w;
	}
      } 
    }
  } else {
    for (uint i = 0; i < raysPerPixel; i++) {
      vec3 rayClr = loadRayClrByIdx(rayBuffer, localRayIdx + i);
      accum += rayClr;
      weightSum += 1.0;
    }
  }
  accum = accum / weightSum;
  vec3 currentAccumClr = data.AccumCount > 0.0 ? (imageLoad(_IMG, imagePos)).xyz : vec3(0.0);
  currentAccumClr += (accum - currentAccumClr) / (data.AccumCount + 1.0);
  imageStore(_IMG, imagePos, vec4(currentAccumClr, 1.0));

  // reinhard
  currentAccumClr = currentAccumClr / (currentAccumClr + 1.0);
  imageStore(_TIMG, imagePos, vec4(currentAccumClr, 1.0));
}
