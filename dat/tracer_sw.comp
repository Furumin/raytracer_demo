#version 460
#include "core.glsl"
#include "tracer_core.glsl"
layout(std430, push_constant) uniform Push_T {
  Sw_pcd Data;
} Push;
layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;
#define _IMG (_images_rgba8[nonuniformEXT(Push.Data.ImageStorageHandle)])
#define _TIMG (_images_rgba8[nonuniformEXT(Push.Data.TonemapImageStorageHandle)])
// due to partial rasterization in the case of large ray counts,
// we use ray idx (which may be offsetted) to calc. image pos, rather then
// the opposite.
void main() {
  Sw_pcd data = Push.Data;
  uint raysPerPixel = 1 << data.RaysPerPixelPow2;
  uint pixelMax = data.Dimensions.x * data.Dimensions.y;
  uint localPixelIdx = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * data.Dimensions.x;
  uint pixelIdx = (Push.Data.RayIdxOffset >> Push.Data.RaysPerPixelPow2) + localPixelIdx;
  uint localRayIdx = localPixelIdx * raysPerPixel;
  if (localRayIdx >= Push.Data.RayCount) return;
  ivec2 imagePos = ivec2(pixelIdx % data.Dimensions.x, pixelIdx / data.Dimensions.x);
  RayChunkBuffer rayBuffer = RayChunkBuffer(data.RayBuffer);
  vec3 accum = vec3(0.0);
  for (uint i = 0; i < raysPerPixel; i++) {
    vec3 rayClr = loadRayClrByIdx(rayBuffer, localRayIdx + i);
    accum += rayClr;
  }
  accum = accum / raysPerPixel;
  vec3 currentAccumClr = (imageLoad(_IMG, imagePos)).xyz;

  currentAccumClr += (accum - currentAccumClr) / (data.AccumCount + 1.0);
  imageStore(_IMG, imagePos, vec4(currentAccumClr, 1.0));

  // reinhard
  currentAccumClr = currentAccumClr / (currentAccumClr + 1.0);
  imageStore(_TIMG, imagePos, vec4(currentAccumClr, 1.0));
}
