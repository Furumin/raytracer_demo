#version 460
#include "core.glsl"
#include "tracer_core.glsl"
layout(std430, push_constant) uniform Push_T {
  Rt_pcd Data;
} Push;
layout(local_size_x = TRACER_RT_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

bool rtSphereKernel(in uint rayIdx, in uint localRayIdx) {
  Rt_pcd data = Push.Data;
  if (localRayIdx >= data.RayCount) return false;
  Ray ray;
  Camera c = CameraBuffer(data.CameraPointer).Data;
  RayChunkBuffer rayBuffer = RayChunkBuffer(data.Buffers[RT_PCD_RAY_BUF]);
#if !TRACER_RAY_HIT_UNIFIED
  HitChunkBuffer hitBuffer = HitChunkBuffer(data.Buffers[RT_PCD_HIT_BUF]);
#endif
  BvhBuffer bvhBuffer = BvhBuffer(data.Buffers[RT_PCD_TLAS_BUF]);
  Hit_record h;
  // (todo) potentially move ray generation to separate pass ( or keep it here,
  // but assert that this intersect pass executed first ) in case we have more
  // intersect passes, e.g. against triangles
  if (data.Depth == 0) {
    // populate ray buffer, default hit records
    vec2 imagePixelPos = vec2(imagePixelPosFromRayIdx(rayIdx, data.Dimensions, data.RaysPerPixelPow2));
    uint rayI = rayIdx & data.RaysPerPixelPow2;
    float defocusRad = c.FocusDistance * tan(degToRad(c.DefocusAngle * 0.5));
    vec2 defocus = defocusRad * randomDisk(data.Hash.xw); 
    ray.Position = c.Position + defocus.x * c.Right + defocus.y * c.Up;
    
    // slightly different sub-pixel pos per sample
    vec2 offset = vec2(0.0);
    offset.x = Push.Data.EnableAntiAliasing > 0 ?
      0.5 * (randomFloatNorm(data.Hash.x + rayI)) : 0;
    offset.y = Push.Data.EnableAntiAliasing > 0 ?
      0.5 * (randomFloatNorm(data.Hash.y + rayI)) : 0;
    if (data.EnableStratifiedSampling == 0) {
    } else {
      // determine grid size
      // (todo) move to cpu!
      uint shiftX = ((data.RaysPerPixelPow2 + 1) >> 1);
      uint tileXCount = 1 << shiftX;
      uint tileYCount = 1 << ((data.RaysPerPixelPow2) >> 1);
      uint x = rayI % tileXCount;
      uint y = rayI >> shiftX;
      float tileW = 1.0 / tileXCount, tileH = 1.0 / tileYCount;

      offset *= vec2(tileW, tileH);
      offset.x += (x * tileW);
      offset.y += (y * tileH);
    }
    imagePixelPos += offset;
    ray.Direction = rayDirFromPixelPos(c, imagePixelPos) - ray.Position;
    ray.Data = 0;
    ray.Color = vec3(1.0);
  } else {
    // fetch ray
    ray = loadRayByIdx(rayBuffer, localRayIdx, false, true);
  }
  ray.T = FLOAT_INF;
      
  uint rayDepth = ray.Data >> 27;
  if (rayDepth != data.Depth) return true;

  float tMin = -FLOAT_INF;
  ObjectBuffer objectBuffer = ObjectBuffer(data.Buffers[RT_PCD_OBJ_BUF]);
  vec3 sphereCenter;
  uint materialIndex;
  uint objId = 0x80000000; // invalid object ID
  if (hitClosest(bvhBuffer, objectBuffer, ray, objId, tMin, sphereCenter, materialIndex)) {
    ray.T = tMin;
    // increment depth
    rayDepth++;
    h.HitPosition = ray.Position + ray.Direction * ray.T;
    vec3 normal = normalize(h.HitPosition - sphereCenter);
    const float zSign = sign(normal.z);
    uint nY = floatBitsToUint(normal.y);
    nY &= (~1);
    nY |= (zSign > 0.0 ? 1 : 0);
    normal.y = uintBitsToFloat(nY);
    h.Normal = normal.xy;
  } else {
    materialIndex = TRACER_INVALID_MATERIAL;
  }
  ray.Data = (rayDepth << TRACER_DEPTH_O) | ((materialIndex) << TRACER_MATERIAL_O) | (ray.Data & 3);
  storeRayByIdx(rayBuffer, localRayIdx, ray, data.Depth == 0, false);
#if TRACER_RAY_HIT_UNIFIED
  storeHitByIdx(rayBuffer, localRayIdx, h);
#else
  storeHitByIdx(hitBuffer, localRayIdx, h);
#endif
  return true;
}
