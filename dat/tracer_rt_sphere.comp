#version 460
#include "core.glsl"
#include "tracer_core.glsl"
layout(std430, push_constant) uniform Push_T {
  Rt_pcd Data;
} Push;
layout(local_size_x = TRACER_RT_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

bool rtSphereKernel(in uint rayIdx, in uint localRayIdx) {
  Rt_pcd data = Push.Data;
  if (localRayIdx >= data.RayCount) return false;
  Ray ray;
  Camera c = CameraBuffer(data.CameraPointer).Data;
  RayChunkBuffer rayBuffer = RayChunkBuffer(data.Buffers[RT_PCD_RAY_BUF]);
  BvhBuffer bvhBuffer = BvhBuffer(data.Buffers[RT_PCD_TLAS_BUF]);
  Hit_record h;
  // (todo) potentially move ray generation to separate pass ( or keep it here,
  // but assert that this intersect pass executed first ) in case we have more
  // intersect passes, e.g. against triangles
  if (data.Depth == 0) {
    // populate ray buffer, default hit records
    float defocusRad = c.FocusDistance * tan(degToRad(c.DefocusAngle * 0.5));
    vec2 defocus = defocusRad * randomDisk(data.Hash.wz); 
    ray.Position = c.Position + defocus.x * c.Right + defocus.y * c.Up;
    vec2 imagePixelPos = imagePosFromRayIdx(rayIdx, data.Dimensions, data.RaysPerPixelPow2, data.Hash.xy, data.EnableAntiAliasing, data.EnableStratifiedSampling);
    ray.Direction = rayDirFromPixelPos(c, imagePixelPos) - ray.Position;
    ray.Data = 0;
  } else {
    // fetch ray
    ray = loadRayByIdx(rayBuffer, localRayIdx, true);
  }
  ray.T = FLOAT_INF;
      
  uint rayDepth = ray.Data >> 27;
  if (rayDepth != data.Depth) return true;

  float tMin = -FLOAT_INF;
  ObjectBuffer objectBuffer = ObjectBuffer(data.Buffers[RT_PCD_OBJ_BUF]);
  vec3 sphereCenter;
  uint materialIndex;
  uint objId = 0x80000000; // invalid object ID
  vec3 normal;
  if (hitClosest(bvhBuffer, objectBuffer, ray, objId, tMin, sphereCenter, materialIndex, normal)) {
    ray.T = tMin;
    // increment depth
    rayDepth++;
    h.HitPosition = ray.Position + ray.Direction * ray.T;
    // compress normal by omitting .z and storing its sign in .y LSB
    const float zSign = sign(normal.z);
    uint nY = floatBitsToUint(normal.y);
    nY &= (~1);
    nY |= (zSign > 0.0 ? 1 : 0);
    normal.y = uintBitsToFloat(nY);
    h.Normal = normal.xy;
  } else {
    materialIndex = TRACER_INVALID_MATERIAL;
  }
  // pack metadata into ray
  ray.Data = (rayDepth << TRACER_DEPTH_O) | ((materialIndex) << TRACER_MATERIAL_O) | (ray.Data & 3);
  storeRayByIdx(rayBuffer, localRayIdx, ray, false);
  if (data.Depth == 0) {
    storeRayClrByIdx(rayBuffer, localRayIdx, vec3(1.0));
  }
  storeHitByIdx(rayBuffer, localRayIdx, h);
  return true;
}
void main() {
  uint stride = ((Push.Data.RayCount) + TRACER_RT_COARSE_FACTOR - 1) / TRACER_RT_COARSE_FACTOR;
  if (gl_GlobalInvocationID.x >= stride) return;
  for (uint i = 0; i < TRACER_RT_COARSE_FACTOR; i++) {
    uint localRayIdx = uint(gl_GlobalInvocationID.x) + i * stride;
    uint rayIdx = Push.Data.RayIdxOffset + localRayIdx;
    bool b = rtSphereKernel(rayIdx, localRayIdx);
  }
}
